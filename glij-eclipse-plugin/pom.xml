<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>lu.kbra.glij</groupId>
		<artifactId>glij</artifactId>
		<version>${revision}</version>
		<relativePath>../</relativePath>
	</parent>

	<artifactId>glij-eclipse-parent</artifactId>
	<packaging>pom</packaging>
	<name>GLiJ Eclipse Update Site Reactor</name>
	<version>${eclipse-plugin-revision}</version>

	<modules>
		<module>lu.kbra.glij.eclipse</module>
		<module>lu.kbra.glij.eclipse.feature</module>
		<module>lu.kbra.glij.eclipse.repository</module>
	</modules>

	<properties>
		<tycho.version>4.0.13</tycho.version>
	</properties>

	<repositories>
		<repository>
			<id>eclipse-2026-09</id>
			<layout>p2</layout>
			<url>https://download.eclipse.org/releases/2026-09/</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<environments>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
