Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: GLiJ Eclipse Integration
Bundle-SymbolicName: lu.kbra.glij.eclipse;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Activator: lu.kbra.glij.eclipse.GLiJPlugin
Bundle-Vendor: UnKabaraQuiDev
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.resources,
 org.eclipse.core.commands,
 org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.ui.ide,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.jface.text,
 org.eclipse.jdt.core,
 org.eclipse.jdt.core.manipulation,
 org.eclipse.text,
 org.eclipse.jdt.ui,
 org.eclipse.jface,
 org.eclipse.swt,
 org.eclipse.equinox.preferences,
 org.eclipse.osgi
Bundle-ClassPath: .,
 lib/glij-api-0.1.0-SNAPSHOT.jar,
 lib/glij-binding-spi-0.1.0-SNAPSHOT.jar,
 lib/glij-compiler-0.1.0-SNAPSHOT.jar,
 lib/glij-engine-adapter-0.1.0-SNAPSHOT.jar,
 lib/javapoet-1.13.0.jar
